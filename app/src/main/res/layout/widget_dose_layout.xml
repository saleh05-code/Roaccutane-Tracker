<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dose_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_rounded_bg">

    <TextView
        android:id="@+id/tv_dose_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💊"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tv_dose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تأكيد الجرعة"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#004D40"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tv_dose_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اضغط للتأكيد"
        android:textSize="9sp"
        android:textColor="#00796B"
        android:gravity="center" />

</LinearLayout>
