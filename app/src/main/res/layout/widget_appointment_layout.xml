<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_appt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="10dp"
    android:background="@drawable/widget_appointment_bg">

    <!-- Part 1: Next Appointment Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 الموعد القادم"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#006A60" />

        <TextView
            android:id="@+id/tv_appt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لا يوجد موعد قادم"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_appt_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جدول مواعيدك من التطبيق"
            android:textSize="9sp"
            android:textColor="#404846"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Divider line -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#C2E8D8"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp" />

    <!-- Part 2: Required Lab Tests -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧪 التحاليل المطلوبة"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#006A60" />

        <TextView
            android:id="@+id/tv_lab_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الدهون والكبد والكلى"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_lab_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سجل فحوصات الدم الشهرية"
            android:textSize="9sp"
            android:textColor="#404846"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
